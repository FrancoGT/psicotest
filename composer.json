{
    "name": "francogt/psicotest",
    "description": "PsicoTest - Buscador de pruebas psicológicas (CodeIgniter 4)",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4.27",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pgsql": "*",
        "laminas/laminas-escaper": "^2.18",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "kint-php/kint": "^6.1",
        "mikey179/vfsstream": "^1.6.12",
        "phpunit/phpunit": "^10.5.16 || ^11.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/",
            "CodeIgniter\\": "system/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
