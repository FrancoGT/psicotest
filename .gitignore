.DS_Store
.env

#-------------------------
# Writable (CodeIgniter 4)
#-------------------------
writable/cache/*
!writable/cache/index.html

writable/logs/*
!writable/logs/index.html

writable/session/*
!writable/session/index.html

writable/uploads/*
!writable/uploads/index.html

writable/debugbar/*
!writable/debugbar/index.html

writable/**/*.db
writable/**/*.sqlite

php_errors.log

#-------------------------
# Composer
#-------------------------
/vendor/
composer.lock

#-------------------------
# Tests
#-------------------------
/build/
/phpunit*.xml
!/phpunit.dist.xml
/.phpunit.*.cache
/.phpunit.cache

#-------------------------
# IDE Files
#-------------------------
/nbproject/
.idea/*
.vscode/

## Sublime Text cache files
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project
